# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=learn_buddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learn_buddy
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# --- Backend / Frontend host ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins the backend accepts cross-origin browser requests from — the
# frontend runs on a different port, so without this every fetch from it
# is blocked by CORS. Comma-separated; add your deployed frontend URL here
# in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ollama Cloud (LLM layer) ---
# Chat / classification / generation model — see CLAUDE.md "Model configuration".
# core/llm_client.py calls OLLAMA_BASE_URL + "/v1/chat/completions" and
# "/v1/embeddings" (the OpenAI-compatible endpoints) — don't include a path.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
# Separate embedding-capable model; gpt-oss:120b-cloud cannot be reused for embeddings.
OLLAMA_EMBED_MODEL=
#
# No API key / running against a local Ollama instead of Ollama Cloud (e.g.
# `ollama serve` on the host)? From inside a Docker container, "localhost"
# is the container itself, so point at the host via host.docker.internal
# (backend/.env.example has the host-direct equivalent, for alembic/pytest
# run outside Docker):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# --- Auth ---
# Every access/refresh token is only as safe as this value — generate a
# real one (e.g. `openssl rand -hex 32`) before this is reachable outside
# your own machine. The backend logs a warning at startup if this is
# still the placeholder default.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ingestion (optional overrides; see backend/src/core/config.py for defaults) ---
# MAX_UPLOAD_SIZE_MB=25
# CHUNK_TARGET_TOKENS=400
# CHUNK_OVERLAP_TOKENS=50
# EMBEDDING_BATCH_SIZE=32
