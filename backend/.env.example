# Local-only, for running alembic/pytest directly on the host (not in
# Docker). Copy to backend/.env and adjust ports if you hit a conflict
# (see wiki/runbook.md). Points at the same services docker-compose starts,
# via the ports it publishes to localhost — the root .env's DATABASE_URL /
# REDIS_URL use in-network service DNS names instead, for the containers.

DATABASE_URL=postgresql+asyncpg://learn_buddy:change-me@localhost:5432/learn_buddy
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
JWT_SECRET=change-me

# Default (core/config.py) already covers localhost:3000/3001 for `npm run
# dev` — override only if the frontend runs somewhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: only needed to run ingestion (uv run pytest already uses a fake
# LLM client — see wiki/ingestion.md). Same as the root .env.example, but
# "localhost" here is correct as-is since this runs directly on the host,
# not in a container.
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:120b-cloud
# OLLAMA_EMBED_MODEL=
#
# Local Ollama instead:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest
